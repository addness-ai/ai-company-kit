# ===== あなたのAI会社の本体（hosted）設定 =====
# このファイルをコピーして .env を作るか、デプロイ先（Render等）の環境変数に設定します。
# 何も設定しなくても起動します（その場合、オフィスはサンプル表示のまま）。
# セットアップは Claude Code が会話で1つずつ案内します。

# --- Google（Gmail / カレンダー） ---
# Google Cloud で OAuth クライアントを作り、リフレッシュトークンを取得して貼ります。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- LINE（公式アカウント / Messaging API） ---
# LINE Developers でチャネルを作成して取得します。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 指示を受け付けるユーザー（自分の userId）。設定すると本人以外の指示は無視します。
LINE_OWNER_USER_ID=

# --- AI（社員の頭脳・任意） ---
# 設定すると、LINEからの指示をAIが解釈して返します。未設定なら定型応答になります。
ANTHROPIC_API_KEY=

# --- 動作設定 ---
# 外向き操作（メール送信・予定作成など）に社長承認を必須にする（推奨: true）
REQUIRE_APPROVAL=true
# オフィス画面(別オリジン)からの取得を許可。通常はそのままでOK。
ALLOW_ORIGIN=*
PORT=3000
